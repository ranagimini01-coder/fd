# Replace MONGO_URL with your MongoDB connection string before starting the backend.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=master_candel

DERIV_ENABLED=true
PORT=7007
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_SYMBOLS=ALL
MARKET_TIMEFRAMES=1s,5s,15s,1m,5m,10m,15m,30m,1h
MARKET_FRESHNESS_SECONDS=30
ANALYSIS_INTERVAL_SECONDS=15
MAX_AGENT_CONCURRENCY=500

# Redis is required for cross-process low-latency validation; memory fallback is single-process only.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MARKET_CACHE_TTL_SECONDS=7200
CROSS_VALIDATION_TOLERANCE_MS=1500
CROSS_VALIDATION_WAIT_MS=250
CROSS_VALIDATION_BASE_BPS=8
CROSS_VALIDATION_MIN_BPS=3
CROSS_VALIDATION_MAX_BPS=30
CROSS_VALIDATION_VOL_MULTIPLIER=4

# Local-only placeholder. Generate a new key and matching SHA-256 before exposing the extension.
OBSERVER_SERVICE_KEY=LOCAL_DEV_ONLY_CHANGE_ME
INGESTION_KEY_SHA256=5a5c97dabf29abe9d7350a6a2cb169788251a71aabadd96b0cd767cc2768d628

PUBLIC_APP_URL=http://localhost:5173
OBSERVER_BACKEND_URL=http://127.0.0.1:7007
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional PostgreSQL mirror; leave blank to disable it.
TEST_BACKEND_URL=http://127.0.0.1:7007
TEST_PROVIDER_CONTROL_KEY=local-dev-test-provider-key
PROVIDER_CONTROL_KEY_SHA256=fd89a2cd5cc2e609d5133e261b2ffaa126db40d7d33b031a0e46ee47fa9aaa8c
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=true
