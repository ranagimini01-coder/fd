# Copy to .env for local development. Do not commit real credentials.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=master_candel

# Live Deriv pair data: ALL uses supported, non-OTC instruments.
# Candle streams are paced and cover the active eligible market universe by default.
DERIV_SYMBOLS=ALL
DERIV_CANDLE_SYMBOLS=ALL
DERIV_MAX_CANDLE_SYMBOLS=100
